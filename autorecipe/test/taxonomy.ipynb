taxonomy = {
    'Asset Health': ['Component', 'Historical Record', 'Asset Profile'],
    'Component': ['Mechanical Issue', 'Electrical Issue', 'Thermal Health Issue', 'Chemical Health Issue'],
    'Mechanical Issue': ['On-Demand Inspection', 'Continuous Sensors', 'Periodic Chemical Sampling'],
    'Electrical Issue': ['Insulin'],
    'Thermal Health Issue': [],
    'Chemical Health Issue': [],
    'Historical Record': ['Asset Maintenance', 'Failure', 'Repair History'],
    'Asset Maintenance': [],
    'Failure': [],
    'Repair History': [],
    'Asset Profile': ['Age', 'Operating Hours', 'Idle Hours']
}

def get_sensors_for_component(component):
    print (component)
    sensors = []
    for child in taxonomy[component]:
        if child.startswith("Mechanical"):
            sensors.append("On-Demand Inspection")
            sensors.append("Continuous Sensors")
            sensors.append("Periodic Chemical Sampling")
        elif child.startswith("Electrical"):
            sensors.append("Insulin")
        else:
            sensors.extend(get_sensors_for_component(child))
    return sensors

def get_sensor_names(sensors):
    sensor_names = []
    for sensor in sensors:
        sensor_names.append(sensor.split(" ")[1])
    return sensor_names

def check_sensor_availability(sensor_names):
    available_sensors = []
    for sensor in sensor_names:
        if sensor in taxonomy:
            available_sensors.append(sensor)
    return available_sensors

def what_sensor_could_be_used_to_check_quality_deterioration(component, sensor_names):
    available_sensors = check_sensor_availability(sensor_names)
    if available_sensors:
        return "What sensor could be used to check such quality deterioration? {}".format(available_sensors[0])
    else:
        return "No sensor could be used to check such quality deterioration."

component = "Electrical Issue"
sensor_names = get_sensor_names(get_sensors_for_component(component))
print(what_sensor_could_be_used_to_check_quality_deterioration(component, sensor_names))